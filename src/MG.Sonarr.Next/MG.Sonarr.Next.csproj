<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<RootNamespace>MG.Sonarr.Next</RootNamespace>
		<Product>PoshSonarr Services Library .NET 10</Product>
		<Description>The service library for the PoshSonarr PowerShell module.</Description>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<NoWarn>1701;1702;CS8981</NoWarn>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<NoWarn>1701;1702;CS8981</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="MG.Sonarr.Next.Shell;MG.Sonarr.Next.Shell.Bases" />
		<AssemblyAttribute Include="MG.Sonarr.Next.Attributes.SonarrObjectConverterAssemblyAttribute" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Caching.Memory" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" />
		<PackageReference Include="Microsoft.Extensions.Http" />
	</ItemGroup>

	<!--
		PowerShell supplies these assemblies itself, so these references exclude the packages' runtime and native assets. NuGet
		applies the exclusion to the packages they depend on as well, and to every project that references this one, so no
		part of PowerShell is copied into the module's folder.
	-->
	<ItemGroup>
		<PackageReference Include="Microsoft.PowerShell.Commands.Utility" ExcludeAssets="runtime;native" />
		<PackageReference Include="System.Management.Automation" ExcludeAssets="runtime;native" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="**\*-*.cs">
			<DependentUpon>$([System.Text.RegularExpressions.Regex]::Replace('$([System.String]::Copy(%(Filename)))', '^(.+)\-.+$', '$1.cs'))</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="Json\Converters\Spans\UtcTimeToLocalConverter.cs" />
		<None Include="Json\Converters\Spans\UtcTimeToLocalConverter.cs" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="MG.Sonarr.Next.Exceptions" />
		<Using Include="MG.Sonarr.Next.Extensions" />
		<Using Include="MG.Sonarr.Next.Numbers.PInt32" Alias="pint" />
		<Using Include="System.Buffers" />
		<Using Include="System.Collections" />
		<Using Include="System.Diagnostics" />
		<Using Include="System.Diagnostics.CodeAnalysis" />
		<Using Include="System.IO" />
		<Using Include="System.Reflection" />
		<Using Include="System.Runtime.CompilerServices" />
		<Using Include="System.Runtime.InteropServices" />
		<Using Include="System.Text" />
		<Using Include="System.Text.Json" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Buffers\Intrinsics\" />
		<Folder Include="Services\Time\" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\MG.Sonarr.Resources\MG.Sonarr.Resources.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Metadata\MetadataList-Enumerator.cs">
			<DependentUpon>MetadataList_T.cs</DependentUpon>
		</Compile>
	</ItemGroup>

</Project>
