<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
	<LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<RootNamespace>MG.Sonarr.Next</RootNamespace>
	<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	<Version>2.0.0</Version>
	<AssemblyVersion>2.0.0</AssemblyVersion>
	<FileVersion>2.0.0</FileVersion>
	<Authors>Mike Garvey</Authors>
	<Company>Yevrag35, LLC.</Company>
	<Product>PoshSonarr Services Library .NET 9</Product>
	<Description>The service library for the PoshSonarr PowerShell module.</Description>
	<Copyright>Copyright © 2018-2025 Yevrag35, LLC.</Copyright>
	<PackageLicenseUrl>https://raw.githubusercontent.com/Yevrag35/PoshSonarr/master/LICENSE</PackageLicenseUrl>
	<PackageProjectUrl>https://github.com/Yevrag35/PoshSonarr</PackageProjectUrl>
	<RepositoryUrl>https://github.com/Yevrag35/PoshSonarr</RepositoryUrl>
	<RepositoryType>Git</RepositoryType>
  </PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="MG.Sonarr.Next.Shell;MG.Sonarr.Next.Shell.Bases" />
		<AssemblyAttribute Include="MG.Sonarr.Next.Attributes.SonarrObjectConverterAssemblyAttribute" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.0-rc.1.25451.107" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0-rc.1.25451.107" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0-rc.1.25451.107" />
		<PackageReference Include="Microsoft.PowerShell.Commands.Utility" Version="7.6.0-preview.5" />
		<PackageReference Include="System.Management.Automation" Version="7.6.0-preview.5" />
	</ItemGroup>

  <ItemGroup>
	<Compile Update="**\*-*.cs">
		<DependentUpon>$([System.Text.RegularExpressions.Regex]::Replace('$([System.String]::Copy(%(Filename)))', '^(.+)\-.+$', '$1.cs'))</DependentUpon>
	</Compile>
  </ItemGroup>

	<ItemGroup>
		<Compile Remove="Json\Converters\Spans\UtcTimeToLocalConverter.cs" />
		<None Include="Json\Converters\Spans\UtcTimeToLocalConverter.cs" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="MG.Sonarr.Next.Exceptions" />
		<Using Include="System.Diagnostics" />
		<Using Include="System.Diagnostics.CodeAnalysis" />
		<Using Include="System.Globalization" />
		<Using Include="System.Linq.Expressions" />
		<Using Include="System.Runtime.CompilerServices" />
		<Using Include="System.Runtime.InteropServices" />
		<Using Include="System.Text.Json" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Services\Time\" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\MG.Sonarr.Next.Standard\MG.Sonarr.Next.Standard.csproj" />
	</ItemGroup>

</Project>
