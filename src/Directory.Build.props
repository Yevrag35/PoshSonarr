<Project>

	<!-- Authorship and repository metadata shared by every assembly. -->
	<PropertyGroup>
		<Authors>Mike Garvey</Authors>
		<Company>Yevrag35, LLC.</Company>
		<Copyright>Copyright © 2018-2025 Yevrag35, LLC.</Copyright>
		<PackageLicenseUrl>https://raw.githubusercontent.com/Yevrag35/PoshSonarr/master/LICENSE</PackageLicenseUrl>
		<PackageProjectUrl>https://github.com/Yevrag35/PoshSonarr</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Yevrag35/PoshSonarr</RepositoryUrl>
		<RepositoryType>Git</RepositoryType>
	</PropertyGroup>

	<!--
		AssemblyVersion and FileVersion reuse Version verbatim so the SDK does not pad them to four parts.
		A Release build of MG.Sonarr.Next.Shell writes PoshSonarr.psd1 with ModuleVersion read from the built DLL, so Version
		is the module's version too.
	-->
	<PropertyGroup>
		<Version>2.0.0</Version>
		<AssemblyVersion>$(Version)</AssemblyVersion>
		<FileVersion>$(Version)</FileVersion>
	</PropertyGroup>

	<!--
		Every project targets net11.0 except the generators' project, which sets netstandard2.0 in its own file. MSBuild
		imports this file before a project's body, so a value that the project sets replaces this one. A project that
		multi-targets through TargetFrameworks must also set TargetFramework to empty, because the SDK builds a project for
		each framework in that list only when TargetFramework is empty, and otherwise builds it for net11.0 alone.
	-->
	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
	</PropertyGroup>

	<!--
		Compiler settings shared by every project. A project can override any of them in its own file. LangVersion is preview
		because the code relies on C# features that the .NET 11 SDK ships only as previews, such as the updated memory safety
		rules, under which a signature that holds a pointer type needs no unsafe modifier and an extern method can be safe.
	-->
	<PropertyGroup>
		<LangVersion>preview</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<!--
		Global usings shared by every project that turns ImplicitUsings on. MSBuild evaluates item conditions after every
		property, so this one sees the value a project sets in its own file.
	-->
	<ItemGroup Condition="'$(ImplicitUsings)' == 'enable' or '$(ImplicitUsings)' == 'true'">
		<Using Include="System.Diagnostics" />
		<Using Include="System.Diagnostics.CodeAnalysis" />
		<Using Include="System.Globalization" />
		<Using Include="System.Linq.Expressions" />
	</ItemGroup>

</Project>
