<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<!-- C# 8 has no global usings, so implicit usings stay off. -->
		<LangVersion>8</LangVersion>
		<ImplicitUsings>disable</ImplicitUsings>
		<RootNamespace>MG.Sonarr.Next</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="MG.Sonarr.Next" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\MG.Sonarr.Resources\MG.Sonarr.Resources.csproj" />
	</ItemGroup>

</Project>
