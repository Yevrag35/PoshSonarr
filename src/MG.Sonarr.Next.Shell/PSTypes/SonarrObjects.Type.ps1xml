<?xml version="1.0" encoding="utf-8" ?> 
<Types>
	<Type>
		<Name>MG.Sonarr.Next.Models.Episodes.EpisodeObject</Name>
		<Members>
			<AliasProperty>
				<Name>Season</Name>
				<ReferencedMemberName>SeasonNumber</ReferencedMemberName>
			</AliasProperty>
			<AliasProperty>
				<Name>Episode</Name>
				<ReferencedMemberName>EpisodeNumber</ReferencedMemberName>
			</AliasProperty>
			<AliasProperty>
				<Name>Absolute</Name>
				<ReferencedMemberName>AbsoluteEpisodeNumber</ReferencedMemberName>
			</AliasProperty>
		</Members>
	</Type>
	<Type>
		<Name>MG.Sonarr.Next.Models.ManualImports.ManualImportObject</Name>
		<Members>
			<ScriptProperty>
				<Name>IsRejected</Name>
				<GetScriptBlock>
					0 -lt $this.Rejections.Count
				</GetScriptBlock>
			</ScriptProperty>
			<ScriptProperty>
				<Name>IsReadyToPost</Name>
				<GetScriptBlock>
					0 -lt $this.Episodes.Count -and 0 -lt $this.Series.Id -and 0 -lt $this.Quality.Quality.Id
				</GetScriptBlock>
			</ScriptProperty>
		</Members>
	</Type>
	<Type>
		<Name>SeriesBase</Name>
		<Members>
			<AliasProperty>
				<Name>Name</Name>
				<ReferencedMemberName>Title</ReferencedMemberName>
			</AliasProperty>
		</Members>
	</Type>
	<Type>
		<Name>MG.Sonarr.Next.Models.System.DiskspaceObject</Name>
		<Members>
			<ScriptProperty>
				<Name>FreeSpaceInGB</Name>
				<GetScriptBlock>
					[System.Math]::Round([double] $this.FreeSpace / 1GB, 2, [System.MidpointRounding]::AwayFromZero)
				</GetScriptBlock>
			</ScriptProperty>
			<ScriptProperty>
				<Name>FreeSpaceInMB</Name>
				<GetScriptBlock>
					[System.Math]::Round([double] $this.FreeSpace / 1MB, 2, [System.MidpointRounding]::AwayFromZero)
				</GetScriptBlock>
			</ScriptProperty>
			<ScriptProperty>
				<Name>FreeSpaceInTB</Name>
				<GetScriptBlock>
					[System.Math]::Round([double] $this.FreeSpace / 1TB, 2, [System.MidpointRounding]::AwayFromZero)
				</GetScriptBlock>
			</ScriptProperty>
			<ScriptProperty>
				<Name>TotalSpaceInGB</Name>
				<GetScriptBlock>
					[System.Math]::Round([double] $this.TotalSpace / 1GB, 2, [System.MidpointRounding]::AwayFromZero)
				</GetScriptBlock>
			</ScriptProperty>
			<ScriptProperty>
				<Name>TotalSpaceInMB</Name>
				<GetScriptBlock>
					[System.Math]::Round([double] $this.TotalSpace / 1MB, 2, [System.MidpointRounding]::AwayFromZero)
				</GetScriptBlock>
			</ScriptProperty>
			<ScriptProperty>
				<Name>TotalSpaceInTB</Name>
				<GetScriptBlock>
					[System.Math]::Round([double] $this.TotalSpace / 1TB, 2, [System.MidpointRounding]::AwayFromZero)
				</GetScriptBlock>
			</ScriptProperty>
		</Members>
	</Type>
</Types>