<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<RootNamespace>MG.Sonarr.Next.Shell</RootNamespace>
		<Product>PoshSonarr Bases .NET 10</Product>
		<Description>The binary library of the PoshSonarr PowerShell module containing the base modules.</Description>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<NoWarn>1701;1702;IDE0130</NoWarn>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<NoWarn>1701;1702;IDE0130</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="Pools\PagingPool.cs" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Pools\PagingPool.cs" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\MG.Sonarr.Next\MG.Sonarr.Next.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Microsoft.Extensions.DependencyInjection" />
		<Using Include="System.Management.Automation" />
	</ItemGroup>

</Project>
