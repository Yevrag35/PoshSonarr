<Project>
	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>
	<ItemGroup>
		<PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.0" />
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
		<PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.0" />
		<!-- Requires System.Management.Automation at its own version or later, so the two move together. -->
		<PackageVersion Include="Microsoft.PowerShell.Commands.Utility" Version="7.6.0-preview.5" />
		<PackageVersion Include="Nullable" Version="1.3.1" />
		<PackageVersion Include="System.Management.Automation" Version="7.6.0-preview.5" />
	</ItemGroup>
</Project>
